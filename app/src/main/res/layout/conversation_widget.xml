<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@drawable/widget_terminal_bg">
 <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="AGENT / BRIDGE" android:textSize="12sp" android:fontFamily="monospace" android:textColor="#91D7A2"/>
 <TextView android:id="@+id/widget_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#A9B9AE" android:maxLines="2" android:ellipsize="end"/>
 <TextView android:id="@+id/widget_message" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:textSize="14sp" android:textColor="#E4ECE5" android:maxLines="3" android:ellipsize="end" android:paddingTop="8dp"/>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
  <Button android:id="@+id/widget_mic" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="48dp" android:minWidth="0dp" android:paddingLeft="3dp" android:paddingRight="3dp" android:maxLines="2" android:text="MIC" android:contentDescription="Сказать реплику" android:textSize="12sp" android:textColor="#91D7A2" android:backgroundTint="#16231B"/>
  <Button android:id="@+id/widget_open" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="48dp" android:minWidth="0dp" android:paddingLeft="3dp" android:paddingRight="3dp" android:maxLines="2" android:text="ЧАТ" android:textSize="12sp" android:textColor="#91D7A2" android:backgroundTint="#16231B"/>
  <Button android:id="@+id/widget_pause" android:layout_width="0dp" android:layout_weight="1.3" android:layout_height="wrap_content" android:minHeight="48dp" android:minWidth="0dp" android:paddingLeft="3dp" android:paddingRight="3dp" android:maxLines="2" android:text="ПАУЗА" android:textSize="11sp" android:textColor="#91D7A2" android:backgroundTint="#16231B"/>
  <Button android:id="@+id/widget_stop" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="48dp" android:minWidth="0dp" android:paddingLeft="3dp" android:paddingRight="3dp" android:maxLines="2" android:text="СТОП" android:textSize="12sp" android:textColor="#F1BC9C" android:backgroundTint="#33231B"/>
 </LinearLayout>
</LinearLayout>
